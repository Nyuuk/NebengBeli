# NebengBeli Environment Configuration Example

# Server
PORT=8080
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=

# Authentication & JWT
JWT_SECRET=
JWT_EXPIRY_HOURS=72
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173


# Rate Limiting (requests per minute)
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=120

# Developer / Test Fixtures (Fail-closed by default; explicitly enable only for local development)
ENABLE_DEV_ENDPOINTS=false
